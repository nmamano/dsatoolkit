# /etc/dsatoolkit/auto-deploy.env (0600, root; the directory is 0700). Plain KEY=value
# lines, read by auto-deploy.sh and never run as shell. No secrets here: the site's API keys
# go in /etc/dsatoolkit/site.env (compose.yaml), and the Cloudflare purge token in
# /etc/dsatoolkit/purge-token (0600, one line).
DSA_IMAGE=ghcr.io/nmamano/dsatoolkit-site
DSA_GITHUB_REPO=nmamano/dsatoolkit
DSA_IMAGE_WORKFLOW=site-image.yml
# The Cloudflare zone of dsatoolkit.com (an ID, not a secret). Without it, no purge runs.
#DSA_CF_ZONE=<zone id>
# Optional: the tag to follow (default main).
#DSA_TAG=main
