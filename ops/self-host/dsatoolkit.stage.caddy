# /etc/wg-caddy/dsatoolkit.caddy (staging; the cut-over replaces it with dsatoolkit.caddy).
# Caddy's internal CA: no ACME and no DNS record. Test with curl --resolve ... -k.
stage.dsatoolkit.com {
	tls internal
	encode zstd gzip
	header X-Robots-Tag "noindex, nofollow, noarchive"
	request_body {
		max_size 64KiB
	}
	log {
		output file /var/log/wg-caddy/dsatoolkit-access.json {
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 168h
		}
		format filter {
			wrap json
			fields {
				request delete
			}
		}
	}
	reverse_proxy unix//run/dsatoolkit/site.sock {
		header_up X-Forwarded-For {client_ip}
		header_up X-Forwarded-Proto https
		flush_interval -1
		lb_try_duration 15s
		lb_try_interval 250ms
		transport http {
			dial_timeout 5s
			response_header_timeout 70s
		}
	}
}
